[Unit]
Description=NodeLite explicitly enabled remote update request bridge
DefaultDependencies=no
After=nodelite-updater-boot.service
Requires=nodelite-updater-boot.service
Before=shutdown.target
Conflicts=shutdown.target

[Path]
PathExists=/var/lib/nodelite-updater/requests/request.json

[Install]
WantedBy=multi-user.target
