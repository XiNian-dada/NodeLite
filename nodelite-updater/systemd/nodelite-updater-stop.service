[Unit]
Description=Fixed NodeLite stop barrier
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f -- /var/lib/nodelite-updater/bridge/stop
ExecStart=-/usr/bin/systemctl reset-failed nodelite-agent.service
ExecStart=/usr/bin/systemctl stop nodelite-agent.service
TimeoutStartSec=25
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nodelite-updater/bridge
ProtectHome=yes
PrivateTmp=yes
