[Unit]
Description=NodeLite explicitly requested signed update
After=network-online.target nodelite-updater-boot.service
Requires=nodelite-updater-boot.service

[Service]
Type=oneshot
User=nodelite-updater
Group=nodelite-read
SupplementaryGroups=nodelite-updater
ExecStart=/usr/local/bin/nodelite-updater apply
UMask=0077
TimeoutStartSec=90
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nodelite-updater
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
