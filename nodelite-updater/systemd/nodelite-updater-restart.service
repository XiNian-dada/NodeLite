[Unit]
Description=Fixed NodeLite restart action
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f -- /var/lib/nodelite-updater/bridge/restart
ExecStart=-/usr/bin/systemctl reset-failed nodelite-agent.service
ExecStart=/usr/bin/systemctl --no-block restart nodelite-agent.service
TimeoutStartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nodelite-updater/bridge
ProtectHome=yes
PrivateTmp=yes
